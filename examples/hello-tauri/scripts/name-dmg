#!/bin/bash
# Tauri writes "{productName}_{version}_{arch}.dmg".
# This example publishes that image as Hello-Dialtone.dmg.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
dmg_dir="$(cd "$here/../../.." && pwd)/target/release/bundle/dmg"
dest="$dmg_dir/Hello-Dialtone.dmg"

shopt -s nullglob
files=("$dmg_dir"/*.dmg)
if [[ ${#files[@]} -eq 0 ]]; then
  echo "name-dmg: no .dmg in $dmg_dir. Run cargo tauri build from examples/hello-tauri first." >&2
  exit 1
fi

others=()
for file in "${files[@]}"; do
  if [[ "$(basename "$file")" != "Hello-Dialtone.dmg" ]]; then
    others+=("$file")
  fi
done

if [[ ${#others[@]} -eq 0 ]]; then
  echo "$dest"
  exit 0
fi

if [[ ${#others[@]} -gt 1 ]]; then
  echo "name-dmg: more than one disk image in $dmg_dir:" >&2
  printf '  %s\n' "${others[@]}" >&2
  exit 1
fi

rm -f "$dest"
mv "${others[0]}" "$dest"
echo "$dest"
